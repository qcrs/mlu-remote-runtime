#include <bang.h>
#include <cn_api.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#define OK(e) do {int st=(int)(e);if(st){fprintf(stderr,"%s=%d line %d\n",#e,st,__LINE__);exit(2);}}while(0)
#define REQUIRE(e) do{if(!(e)){fprintf(stderr,"%s line %d\n",#e,__LINE__);exit(3);}}while(0)
struct GraphLeaf { const int *input,*nullable; int add; };
struct GraphPayload { GraphLeaf fields[2]; uint64_t scalar; };
extern "C" __mlu_entry__ void graph_relocated(GraphPayload p,int bias,int *output) {
  output[0]=p.fields[0].input[0]+p.fields[0].add+bias;
  output[1]=p.fields[1].input[0]+p.fields[1].add+(p.fields[0].nullable ? p.fields[0].nullable[0] : 0);
  output[2]=(int)(p.scalar&0xffff);
}
extern "C" __mlu_entry__ void graph_empty(void) {}
#ifdef TEST_CNRT
#define API(n) cnrt##n
#define Graph cnrtTaskTopo_t
#define Node cnrtTaskTopoNode_t
#define Entity cnrtTaskTopoEntity_t
#define Queue cnrtQueue_t
#define Params cnrtKernelNodeParams_t
#define Attr cnrtKernelNodeAttrValue_t
#define CopyParams cnrtMemcpy3dParam_t
typedef void *Address;
#define ATTR cnrtKernelNodeAttributeAccessPolicyWindow
#define SYNC(q) cnrtQueueSync(q)
#define QCREATE(q) cnrtQueueCreate(q)
#define QDESTROY(q) cnrtQueueDestroy(q)
#define ALLOC(p) cnrtMalloc(p,64)
#define FREE(p) cnrtFree(p)
#define H2D(d,s) cnrtMemcpy(d,s,64,cnrtMemcpyHostToDev)
#define D2H(d,s) cnrtMemcpy(d,s,64,cnrtMemcpyDevToHost)
#define H2DA(d,s,q) cnrtMemcpyAsync(d,s,64,q,cnrtMemcpyHostToDev)
#define D2HA(d,s,q) cnrtMemcpyAsync(d,s,64,q,cnrtMemcpyDevToHost)
#define HALLOC(p) cnrtHostMalloc(p,256)
#define HFREE(p) cnrtFreeHost(p)
#else
#define API(n) cn##n
#define Graph CNtaskTopo
#define Node CNtaskTopoNode
#define Entity CNtaskTopoEntity
#define Queue CNqueue
#define Params CN_KERNEL_NODE_PARAMS
#define Attr CNkernelNodeAttrValue
#define CopyParams CNmemcpy3dParam
typedef CNaddr Address;
#define ATTR CN_KERNEL_NODE_ATTRIBUTE_ACCESS_POLICY_WINDOW
#define SYNC(q) cnQueueSync(q)
#define QCREATE(q) cnCreateQueue(q,0)
#define QDESTROY(q) cnDestroyQueue(q)
#define ALLOC(p) cnMalloc(p,64)
#define FREE(p) cnFree(p)
#define H2D(d,s) cnMemcpyHtoD(d,s,64)
#define D2H(d,s) cnMemcpyDtoH(d,s,64)
#define H2DA(d,s,q) cnMemcpyHtoDAsync(d,s,64,q)
#define D2HA(d,s,q) cnMemcpyDtoHAsync(d,s,64,q)
#define HALLOC(p) cnMallocHost(p,256)
#define HFREE(p) cnFreeHost(p)
#endif
static CopyParams host_copy(void *dst,void *src,int direction) {
  CopyParams p={};p.dst=p.dstPtr.ptr=dst;p.src=p.srcPtr.ptr=src;
  p.dstPtr.pitch=p.srcPtr.pitch=p.dstPtr.xsize=p.srcPtr.xsize=64;
  p.dstPtr.ysize=p.srcPtr.ysize=1;p.extent.width=64;p.extent.height=p.extent.depth=1;
#ifdef TEST_CNRT
  p.dir=(cnrtMemTransDir_t)direction;
#else
  p.dir=direction;
#endif
  return p;
}
static void host_mixed(Address input,Address output,Queue queue,Params params) {
  int *host;OK(HALLOC((void **)&host));int *source=host,*result=host+16,*after=host+32,*baseline=host+48;
  for(int i=0;i<16;i++) {source[i]=i==1 ? 11 : i==3 ? 18 : -77;result[i]=after[i]=-99;baseline[i]=100+i;}
  Graph graph;Node nodes[3];Entity entity;OK(API(TaskTopoCreate)(&graph,0));
  CopyParams p=host_copy((void *)(uintptr_t)input,source,2);OK(API(TaskTopoAddMemcpyNode)(&nodes[0],graph,NULL,0,&p));
  OK(API(TaskTopoAddKernelNode)(&nodes[1],graph,nodes,1,&params));
  p=host_copy(result,(void *)(uintptr_t)output,3);OK(API(TaskTopoAddMemcpyNode)(&nodes[2],graph,nodes+1,1,&p));
  OK(API(TaskTopoInstantiate)(&entity,graph,NULL,NULL,0));
  OK(H2DA(input,baseline,queue));OK(D2HA(result,input,queue));
  OK(API(TaskTopoEntityInvoke)(entity,queue));OK(D2HA(after,output,queue));OK(SYNC(queue));
  for(int i=0;i<16;i++) {
    int expected=i==1 ? 11+2+*(int *)params.kernelParams[1] : i==2 ? 18+5 :
      i==3 ? (int)(((GraphPayload *)params.kernelParams[0])->scalar&0xffff) : -77;
    REQUIRE(result[i]==expected && after[i]==expected);
  }
  OK(API(TaskTopoEntityInvoke)(entity,queue));OK(H2DA(input,baseline,queue));OK(D2HA(result,input,queue));
  OK(API(TaskTopoEntityDestroy)(entity));OK(API(TaskTopoDestroy)(graph));OK(SYNC(queue));
  for(int i=0;i<16;i++) REQUIRE(result[i]==baseline[i]);
  OK(H2D(input,source));OK(HFREE(host));
  puts("PASS Host H2D/kernel/D2H graph mixed with ordinary async copies and overlapping publication");
}
static void check(Address output,GraphPayload p,int bias) {
  int values[16];OK(D2H(values,output));
  REQUIRE(values[0]==-77 && values[4]==-77 && values[15]==-77);
  REQUIRE(values[1]==11+2+bias && values[2]==18+5 && values[3]==(int)(p.scalar&0xffff));
}
int main(int argc,char **argv) {
  int remote=getenv("MLU_TEST_SHIM")!=NULL;const char *mode=argc>1 ? argv[1] : "normal";
#ifdef TEST_CNRT
  OK(cnrtSetDevice(0));
#else
  OK(cnInit(0));CNdev device;CNcontext context;OK(cnDeviceGet(&device,0));OK(cnCtxCreate(&context,0,device));
  CNmodule module;CNkernel kernel,empty;REQUIRE(argc>2);OK(cnModuleLoad(argv[2],&module));
  OK(cnModuleGetKernel(module,"graph_relocated",&kernel));OK(cnModuleGetKernel(module,"graph_empty",&empty));
#endif
  Address input,output;OK(ALLOC(&input));OK(ALLOC(&output));
  int values[16];for(int i=0;i<16;i++)values[i]=i==1 ? 11 : i==3 ? 18 : -77;OK(H2D(input,values));
  for(int i=0;i<16;i++)values[i]=-77;OK(H2D(output,values));
  GraphPayload p={};p.fields[0]=(GraphLeaf){(int *)(uintptr_t)input+1,NULL,2};
  p.fields[1]=(GraphLeaf){(int *)(uintptr_t)input+3,NULL,5};p.scalar=(uintptr_t)input;
  GraphPayload expected=p;int bias=10;int *destination=(int *)(uintptr_t)output+1;void *args[]={&p,&bias,&destination};
  Params params={};params.kernelParams=args;
#ifdef TEST_CNRT
  params.func=(void *)graph_relocated;params.dim.x=params.dim.y=params.dim.z=1;params.type=cnrtFuncTypeBlock;
#else
  params.hkernel=kernel;params.dimx=params.dimy=params.dimz=1;params.c=CN_KERNEL_CLASS_BLOCK;
#endif
  Queue queue;OK(QCREATE(&queue));Graph graph,clone;Node node,cloned,zero;Entity entity,child_entity;
  OK(API(TaskTopoCreate)(&graph,0));OK(API(TaskTopoAddKernelNode)(&node,graph,NULL,0,&params));
  Params noargs=params;noargs.kernelParams=NULL;
#ifdef TEST_CNRT
  noargs.func=(void *)graph_empty;
#else
  noargs.hkernel=empty;
#endif
  OK(API(TaskTopoAddKernelNode)(&zero,graph,&node,1,&noargs));
  Params got={};OK(API(TaskTopoKernelNodeGetParams)(node,&got));
  REQUIRE(got.extra==NULL && got.reserve==0 && got.kernelParams && *(int *)got.kernelParams[1]==10);
  REQUIRE(!memcmp(got.kernelParams[0],&expected,sizeof(expected)) && *(int **)got.kernelParams[2]==destination);
#ifdef TEST_CNRT
  REQUIRE(got.func==params.func && got.dim.x==1 && got.type==cnrtFuncTypeBlock);
#else
  REQUIRE(got.hkernel==params.hkernel && got.dimx==1 && got.c==CN_KERNEL_CLASS_BLOCK);
#endif
  void **snapshot=got.kernelParams;p.fields[0].add=999;bias=99;
  OK(API(TaskTopoKernelNodeGetParams)(node,&got));REQUIRE(*(int *)snapshot[1]==10 && *(int *)got.kernelParams[1]==10);p=expected;
  Attr attr={};OK(API(TaskTopoKernelNodeGetAttribute)(node,ATTR,&attr));REQUIRE(attr.accessPolicyWindow.numBytes==0);
  OK(API(TaskTopoKernelNodeSetAttribute)(node,ATTR,&attr));
  attr.accessPolicyWindow.baseAddr=input;attr.accessPolicyWindow.numBytes=64;attr.accessPolicyWindow.hitRatio=.5f;
  int attribute_status=API(TaskTopoKernelNodeSetAttribute)(node,ATTR,&attr);REQUIRE(attribute_status==100006);printf("attribute_status=%d\n",attribute_status);
  OK(API(TaskTopoKernelNodeCopyAttributes)(zero,node));
  OK(API(TaskTopoKernelNodeGetAttribute)(zero,ATTR,&attr));REQUIRE(attr.accessPolicyWindow.numBytes==0);
  OK(API(TaskTopoClone)(&clone,graph));OK(API(TaskTopoNodeFindInClone)(&cloned,node,clone));
  bias=20;OK(API(TaskTopoKernelNodeSetParams)(node,&params));
  OK(API(TaskTopoKernelNodeGetParams)(cloned,&got));REQUIRE(*(int *)got.kernelParams[1]==10);
  OK(API(TaskTopoInstantiate)(&entity,graph,NULL,NULL,0));
  bias=30;OK(API(TaskTopoEntityKernelNodeSetParams)(entity,node,&params));
  bias=40;OK(API(TaskTopoKernelNodeSetParams)(node,&params));
  OK(API(TaskTopoEntityInvoke)(entity,queue));OK(SYNC(queue));check(output,expected,30);
  Node error=NULL;int update=-1;OK(API(TaskTopoEntityUpdate)(entity,clone,&error,(
#ifdef TEST_CNRT
    cnrtTaskTopoEntityUpdateResult_t *
#else
    CNtaskTopoEntityUpdateResult *
#endif
  )&update));REQUIRE(update==0);
  OK(API(TaskTopoEntityInvoke)(entity,queue));OK(SYNC(queue));check(output,expected,10);
  host_mixed(input,output,queue,params);
  Graph outer,borrowed;Node child;OK(API(TaskTopoCreate)(&outer,0));OK(API(TaskTopoAddChildTopoNode)(&child,outer,NULL,0,clone));
  OK(API(TaskTopoChildTopoNodeGetTopo)(child,&borrowed));Node children[2];size_t count=2;OK(API(TaskTopoGetNodes)(borrowed,children,&count));REQUIRE(count==2);
  for(size_t i=0;i<count;i++) {
    Params cp={};OK(API(TaskTopoKernelNodeGetParams)(children[i],&cp));if(cp.kernelParams) REQUIRE(*(int *)cp.kernelParams[1]==10);
  }
  OK(API(TaskTopoInstantiate)(&child_entity,outer,NULL,NULL,0));
  if(remote && strcmp(mode,"normal")) {
    OK(FREE(input));
#ifndef TEST_CNRT
    OK(cnModuleUnload(module));
    REQUIRE(cnInvokeKernel(kernel,1,1,1,CN_KERNEL_CLASS_BLOCK,0,NULL,args,NULL)==CN_ERROR_INVALID_KERNEL);
#endif
    if(!strcmp(mode,"abrupt")) {_exit(0);}
#ifdef TEST_CNRT
    if(!strcmp(mode,"reset")) {OK(cnrtDeviceReset());puts("PASS kernel graph reset releases live executable leases");return 0;}
#else
    if(!strcmp(mode,"reset")) {OK(cnCtxDestroy(context));puts("PASS kernel graph context close releases live executable leases");return 0;}
#endif
    OK(API(TaskTopoKernelNodeGetParams)(node,&got));
    REQUIRE(*(int *)got.kernelParams[1]==40 && !memcmp(got.kernelParams[0],&expected,sizeof(expected)));
    puts("PASS public retirement retains kernel module/allocation backing and getter identities");
  }
  OK(API(TaskTopoDestroy)(clone));OK(API(TaskTopoDestroy)(outer));OK(API(TaskTopoDestroy)(graph));
  OK(API(TaskTopoEntityInvoke)(child_entity,queue));
  /* Release executable and queue before completion: invocation owns leases. */
  OK(API(TaskTopoEntityDestroy)(child_entity));OK(API(TaskTopoEntityDestroy)(entity));OK(QDESTROY(queue));
#ifdef TEST_CNRT
  OK(cnrtSyncDevice());
#else
  OK(cnCtxSync());
#endif
  check(output,expected,10);
  if(!remote || !strcmp(mode,"normal")) {OK(FREE(input));
#ifndef TEST_CNRT
    OK(cnModuleUnload(module));
#endif
  }
  OK(FREE(output));
#ifdef TEST_CNRT
  OK(cnrtDeviceReset());
#else
  OK(cnCtxDestroy(context));
#endif
  puts("PASS kernel graph scalar/pointer/aggregate relocation, snapshot, clone, entity set/update, child, attributes and completion leases");return 0;
}
