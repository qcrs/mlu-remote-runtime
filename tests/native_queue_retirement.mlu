#include <bang.h>
#include <cn_api.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define CHECK(e) do { int r_ = (int)(e); if (r_) { fprintf(stderr, "line %d %s status=%d\n", __LINE__, #e, r_); exit(2); } } while (0)
#define REQUIRE(e) do { if (!(e)) { fprintf(stderr, "line %d assertion: %s\n", __LINE__, #e); exit(3); } } while (0)

/* Enough finite work to remain pending across destroy and TCP round trips.
 * Assertions use completion state, never an absolute latency threshold. */
__mlu_entry__ void retire_work(unsigned int *out, int iterations) {
  volatile unsigned int value = 7;
  for (int i = 0; i < iterations; ++i) value = value * 1664525u + 1013904223u;
  *out = value;
}
static const int iterations = 500000;
static double seconds(void) {
  struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
  return ts.tv_sec + ts.tv_nsec * 1e-9;
}
static unsigned expected(void) {
  unsigned value = 7;
  for (int i = 0; i < iterations; ++i) value = value * 1664525u + 1013904223u;
  return value;
}

static void runtime_test(void) {
  for (int frontier = 0; frontier < 5; ++frontier) {
    unsigned *device = NULL, got[3] = {0}, source = 0x12345678;
    void *scratch = NULL;
    cnrtQueue_t q, next;
    cnrtNotifier_t done;
    CHECK(cnrtMalloc((void **)&device, sizeof(got)));
    CHECK(cnrtMemset(device, 0xa5, sizeof(got)));
    CHECK(cnrtMalloc(&scratch, 4));
    CHECK(cnrtQueueCreate(&q)); CHECK(cnrtNotifierCreate(&done));
    cnrtDim3_t dim = {1, 1, 1};
    retire_work<<<dim, cnrtFuncTypeBlock, q>>>(device, iterations);
    CHECK(cnrtGetLastError());
    CHECK(cnrtMemcpyAsync(device + 1, &source, 4, q, cnrtMemcpyHostToDev));
    CHECK(cnrtMemcpyAsync(device + 2, device + 1, 4, q, cnrtMemcpyDevToDev));
    CHECK(cnrtPlaceNotifier(done, q));
    /* This SDK returns cnrtErrorNotReady (1), despite the Busy header prose. */
    REQUIRE(cnrtQueryNotifier(done) == cnrtErrorNotReady);
    /* Native 3.5.2 can report notifier success after pending destruction before
     * the expected data is visible (see the separate observation mode). Obtain
     * numerical baseline before native destruction; Remote preserves work. */
    if (!getenv("MLU_TEST_SHIM") && !getenv("MLU_QUEUE_OBSERVE_NATIVE")) CHECK(cnrtWaitNotifier(done));
    double start = seconds(); CHECK(cnrtQueueDestroy(q)); double elapsed = seconds() - start;
    cnrtRet_t after = cnrtQueryNotifier(done);
    fprintf(stderr, "destroy runtime frontier=%d seconds=%.6f after=%d\n", frontier, elapsed, (int)after);
    REQUIRE(after == cnrtSuccess || after == cnrtErrorNotReady);
    if (getenv("MLU_QUEUE_OBSERVE_NATIVE")) {
      CHECK(cnrtWaitNotifier(done)); CHECK(cnrtMemcpy(got, device, sizeof(got), cnrtMemcpyDevToHost));
      printf("Native pending destroy observation: after=%d output=%u,%u,%u reference=%u,305419896,305419896\n",
             (int)after, got[0], got[1], got[2], expected());
      CHECK(cnrtNotifierDestroy(done)); CHECK(cnrtFree(device)); CHECK(cnrtFree(scratch));
      return;
    }
    if (getenv("MLU_TEST_SHIM")) {
      REQUIRE(after == cnrtErrorNotReady);
      REQUIRE(cnrtQueueQuery(q) != cnrtSuccess);
      REQUIRE(cnrtQueueDestroy(q) != cnrtSuccess);
      (void)cnrtGetLastError();
      source = 0;
    }
    CHECK(cnrtQueueCreate(&next));
    if (frontier == 0) CHECK(cnrtWaitNotifier(done));
    if (frontier == 1) CHECK(cnrtSyncDevice());
    if (frontier == 2) { CHECK(cnrtFree(scratch)); scratch = NULL; }
    if (frontier == 3) {
      cnrtRet_t ready;
      do { ready = cnrtQueryNotifier(done); if (ready == cnrtErrorNotReady) { struct timespec pause = {0, 1000000}; nanosleep(&pause, NULL); } } while (ready == cnrtErrorNotReady);
      CHECK(ready);
    }
    if (frontier == 4) { CHECK(cnrtQueueWaitNotifier(done, next, 0)); CHECK(cnrtQueueSync(next)); }
    CHECK(cnrtQueryNotifier(done));
    CHECK(cnrtMemcpy(got, device, sizeof(got), cnrtMemcpyDevToHost));
    fprintf(stderr, "runtime data=%u,%u,%u expected=%u\n", got[0], got[1], got[2], expected());
    REQUIRE(got[0] == expected() && got[1] == 0x12345678 && got[2] == got[1]);
    CHECK(cnrtQueueDestroy(next)); CHECK(cnrtNotifierDestroy(done));
    CHECK(cnrtFree(device)); if (scratch) CHECK(cnrtFree(scratch));
    (void)cnrtGetLastError();
  }
  for (int i = 0; i < 1200; ++i) { cnrtQueue_t q; CHECK(cnrtQueueCreate(&q)); CHECK(cnrtQueueDestroy(q)); }
  unsigned *device = NULL; cnrtQueue_t q;
  CHECK(cnrtMalloc((void **)&device, 4)); CHECK(cnrtQueueCreate(&q));
  cnrtDim3_t dim = {1, 1, 1};
  retire_work<<<dim, cnrtFuncTypeBlock, q>>>(device, iterations);
  CHECK(cnrtGetLastError()); CHECK(cnrtQueueDestroy(q)); CHECK(cnrtDeviceReset());
  puts("PASS CNRT retirement; notifier wait/query, context/free and cross-queue completion preserve kernel and H2D/D2D; 1200 retirements and pending reset");
}

static void driver_test(const char *image) {
  CHECK(cnInit(0)); CNcontext ctx; CHECK(cnCtxCreate(&ctx, 0, 0));
  for (int frontier = 0; frontier < 6; ++frontier) {
    CNaddr device = 0, scratch = 0;
    unsigned got[3] = {0}, source = 0x12345678;
    CNqueue q, next; CNnotifier done; CNmodule module; CNkernel kernel;
    CHECK(cnModuleLoad(image, &module)); CHECK(cnModuleGetKernel(module, "_Z10drain_workPji", &kernel));
    CHECK(cnMalloc(&device, sizeof(got))); CHECK(cnMalloc(&scratch, 4));
    CHECK(cnMemsetD8(device, 0xa5, sizeof(got)));
    CHECK(cnCreateQueue(&q, 0)); CHECK(cnCreateNotifier(&done, 0));
    int count = iterations; void *args[] = {&device, &count};
    CHECK(cnInvokeKernel(kernel, 1, 1, 1, CN_KERNEL_CLASS_BLOCK, 0, q, args, NULL));
    CHECK(cnMemcpyHtoDAsync(device + 4, &source, 4, q));
    CHECK(cnMemcpyDtoDAsync(device + 8, device + 4, 4, q)); CHECK(cnPlaceNotifier(done, q));
    REQUIRE(cnQueryNotifier(done) == CN_ERROR_NOT_READY);
    if (!getenv("MLU_TEST_SHIM") && !getenv("MLU_QUEUE_OBSERVE_NATIVE")) CHECK(cnWaitNotifier(done));
    double start = seconds(); CHECK(cnDestroyQueue(q)); double elapsed = seconds() - start;
    CNresult after = cnQueryNotifier(done);
    fprintf(stderr, "destroy driver frontier=%d seconds=%.6f after=%d\n", frontier, elapsed, (int)after);
    REQUIRE(after == CN_SUCCESS || after == CN_ERROR_NOT_READY);
    if (getenv("MLU_QUEUE_OBSERVE_NATIVE")) {
      CHECK(cnWaitNotifier(done)); CHECK(cnMemcpyDtoH(got, device, sizeof(got)));
      printf("Native pending destroy observation: after=%d output=%u,%u,%u reference=%u,305419896,305419896\n",
             (int)after, got[0], got[1], got[2], expected());
      CHECK(cnDestroyNotifier(done)); CHECK(cnFree(device)); CHECK(cnFree(scratch));
      CHECK(cnModuleUnload(module)); CHECK(cnCtxDestroy(ctx)); return;
    }
    if (getenv("MLU_TEST_SHIM")) {
      REQUIRE(after == CN_ERROR_NOT_READY);
      REQUIRE(cnQueryQueue(q) == CN_QUEUE_ERROR_INVALID);
      REQUIRE(cnDestroyQueue(q) == CN_QUEUE_ERROR_INVALID);
      source = 0;
    }
    CHECK(cnCreateQueue(&next, 0));
    if (frontier == 0) CHECK(cnWaitNotifier(done));
    if (frontier == 1) CHECK(cnCtxSync());
    if (frontier == 2) { CHECK(cnFree(scratch)); scratch = 0; }
    if (frontier == 3) { CHECK(cnModuleUnload(module)); module = NULL; }
    if (frontier == 4) {
      CNresult ready;
      do { ready = cnQueryNotifier(done); if (ready == CN_ERROR_NOT_READY) { struct timespec pause = {0, 1000000}; nanosleep(&pause, NULL); } } while (ready == CN_ERROR_NOT_READY);
      CHECK(ready);
    }
    if (frontier == 5) { CHECK(cnQueueWaitNotifier(next, done)); CHECK(cnQueueSync(next)); }
    CHECK(cnQueryNotifier(done)); CHECK(cnMemcpyDtoH(got, device, sizeof(got)));
    fprintf(stderr, "driver data=%u,%u,%u expected=%u\n", got[0], got[1], got[2], expected());
    REQUIRE(got[0] == expected() && got[1] == 0x12345678 && got[2] == got[1]);
    CHECK(cnDestroyQueue(next)); CHECK(cnDestroyNotifier(done)); CHECK(cnFree(device));
    if (scratch) CHECK(cnFree(scratch)); if (module) CHECK(cnModuleUnload(module));
  }
  for (int i = 0; i < 1200; ++i) { CNqueue q; CHECK(cnCreateQueue(&q, 0)); CHECK(cnDestroyQueue(q)); }
  CNaddr device; CNqueue q; CNmodule module; CNkernel kernel;
  CHECK(cnModuleLoad(image, &module)); CHECK(cnModuleGetKernel(module, "_Z10drain_workPji", &kernel));
  CHECK(cnMalloc(&device, 4)); CHECK(cnCreateQueue(&q, 0));
  int count = iterations; void *args[] = {&device, &count};
  CHECK(cnInvokeKernel(kernel, 1, 1, 1, CN_KERNEL_CLASS_BLOCK, 0, q, args, NULL));
  CHECK(cnDestroyQueue(q)); CHECK(cnCtxDestroy(ctx));
  puts("PASS CNDrv retirement; notifier wait/query, context/free/module and cross-queue completion preserve kernel and H2D/D2D; 1200 retirements and pending teardown");
}
int main(int argc, char **argv) {
  REQUIRE(argc == 2 || argc == 3);
  if (!strcmp(argv[1], "runtime")) runtime_test();
  else { REQUIRE(argc == 3 && !strcmp(argv[1], "driver")); driver_test(argv[2]); }
  return 0;
}
