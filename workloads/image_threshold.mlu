#include "common.h"

__mlu_entry__ void image_threshold_kernel(float *a, float *c, int n) {
  for(int i=taskId;i<n;i+=taskDim)c[i]=a[i]>127?255:0;
}

int main(void) {
  const int n=262144;
  float *a=(float *)malloc(n*sizeof(float)),*b=(float *)malloc(n*sizeof(float));
  float *ref=(float *)malloc(n*sizeof(float)),*out=(float *)malloc(n*sizeof(float));
  if(!a||!b||!ref||!out)return 2;
  for(int i=0;i<n;++i){a[i]=(float)((i*37+i/512*13)%256);b[i]=(float)((i%17)-8)/16.0f;}
  for(int i=0;i<n;++i)ref[i]=a[i]>127?255:0;
  float *da=device_copy(a,n),*dc=NULL;CHECK(cnrtMalloc((void **)&dc,n*sizeof(float)));
  cnrtQueue_t queue=NULL;CHECK(cnrtQueueCreate(&queue));
  cnrtDim3_t dim={4,1,1};
  image_threshold_kernel<<<dim,cnrtFuncTypeBlock,queue>>>(da,dc,n);
  CHECK(cnrtGetLastError());
  CHECK(cnrtQueueSync(queue));
  CHECK(cnrtMemcpy(out,dc,n*sizeof(float),cnrtMemcpyDevToHost));
  int result=report("image_threshold","512x512",ref,out,n,0);
  CHECK(cnrtQueueDestroy(queue));CHECK(cnrtFree(da));CHECK(cnrtFree(dc));
  free(a);free(b);free(ref);free(out);return result;
}
