#include <bang.h>

/* Server-side preset module. The wire protocol sends only the kernel ID and
 * typed device allocation IDs; native CNDrv receives these resolved pointers. */
__mlu_entry__ void vector_add(float *dst, const float *a, const float *b, int n) {
  if (!dst || !a || !b || n <= 0) return;
  for (int i = 0; i < n; ++i) dst[i] = a[i] + b[i];
}
